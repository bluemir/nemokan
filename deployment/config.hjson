// nemokan 운영 설정 예시. ~/.config/nemokan/config.hjson 로 복사해서 고친다.
{
	auth: {
		passkey: {
			// WebAuthn Relying Party 설정. 실제 도메인을 적는다.
			// credential 은 id 에 묶이므로 나중에 바꾸면 기존 passkey 를 쓸 수 없다.
			displayName: nemokan
			id: example.com
			origins: ["https://example.com"]
		}
	}

	// 계정 복구 메일을 보내려면 채운다. 비어 있으면 메일 발송이 에러를 낸다.
	// mail: {
	//   host: smtp.example.com
	//   // 실존하는 발신 주소여야 한다
	//   from: noreply@example.com
	//   // 인증이 붙은 릴레이는 보통 587. 465(implicit TLS)는 쓸 수 없다
	//   port: 587
	//   // 비우면 인증 없이 보낸다
	//   username: noreply@example.com
	//   password: ""
	// }
}
